# Copy to .env and fill in. Never commit .env. Only Agent A adds names here (CLAUDE.md rule 9).
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai/v1
CALA_PER_MINUTE=60          # Cala calls a minute for one process (the key allows 100 in total)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=          # Flash-tier model id
GEMINI_MODEL_SMART=         # Pro-tier model id (optional)
MONGODB_URI=
MONGODB_DB=pitchlist
VERDA_API_KEY=
GEMINI_EMBED_MODEL=         # embedding model for vector search (default gemini-embedding-001)
USE_VECTOR_SEARCH=false     # true = competitor candidates also come from vector search (A13)
VERDA_EMBED_MODEL=          # unused: Verda's Inference API has no embeddings endpoint
VERDA_CLIENT_ID=            # Verda Cloud API credentials (console -> Keys): only for deploy/verda.py
VERDA_CLIENT_SECRET=
VERDA_REGISTRY_USER=        # Verda Container Registry credentials: deploy/verda.py batch-image
VERDA_REGISTRY_SECRET=
VERDA_INFERENCE_KEY=        # Verda Inference API key: triggers the batch job (deploy/verda.py batch-run)
USE_FAKE_STORE=true         # B and C develop on fixtures until the real store is ready (CP2)
CACHE_ONLY=false            # true = demo runs from the Atlas cache with no Cala calls
CALA_REQUIRE_CACHE=false    # true on the server: never call Cala when the cache is unreachable
API_URL=http://localhost:8000   # frontend -> backend; C's mock runs on another port
